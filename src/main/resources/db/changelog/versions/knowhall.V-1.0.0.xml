<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:pro="http://www.liquibase.org/xml/ns/pro"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
    http://www.liquibase.org/xml/ns/pro
    http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">

  <changeSet id="KH-3" author="Gabriel Marassi">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="USUARIO_TAGS"/>
      </not>
      <tableExists tableName="USUARIO"/>
      <tableExists tableName="TAGS"/>
    </preConditions>
    <createTable tableName="USUARIO_TAGS">
      <column name="usuario_id" type="INTEGER">
        <constraints nullable="false"/>
      </column>
      <column name="tag_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey
      tableName="USUARIO_TAGS"
      columnNames="usuario_id, tag_id"
      constraintName="pk_usuario_tags"/>

    <addForeignKeyConstraint
      baseTableName="USUARIO_TAGS"
      baseColumnNames="usuario_id"
      constraintName="fk_usuario_tags_usuario"
      referencedTableName="USUARIO"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <addForeignKeyConstraint
      baseTableName="USUARIO_TAGS"
      baseColumnNames="tag_id"
      constraintName="fk_usuario_tags_tags"
      referencedTableName="TAGS"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <comment>Criação da tabela de relacionamento USUARIO_TAGS</comment>
  </changeSet>

  <changeSet id="KH-20" author="Gabriel Marassi">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="POST_TAGS"/>
      </not>
      <tableExists tableName="POST"/>
      <tableExists tableName="TAGS"/>
    </preConditions>
    <createTable tableName="POST_TAGS">
      <column name="post_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tag_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey
      tableName="POST_TAGS"
      columnNames="post_id, tag_id"
      constraintName="pk_post_tags"/>

    <addForeignKeyConstraint
      baseTableName="POST_TAGS"
      baseColumnNames="post_id"
      constraintName="fk_post_tags_post"
      referencedTableName="POST"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <addForeignKeyConstraint
      baseTableName="POST_TAGS"
      baseColumnNames="tag_id"
      constraintName="fk_post_tags_tags"
      referencedTableName="TAGS"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <comment>Criação da tabela de relacionamento POST_TAGS</comment>
  </changeSet>
  
    <changeSet id="KH-25" author="Willyan Tomaz">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="IMAGEM"/>
      </not>
    </preConditions>
    <createTable tableName="IMAGEM">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="nome" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="url" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="id_imagem" type="VARCHAR(255)"/>
      <column name="path" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <comment>Criação da tabela IMAGEM</comment>
  </changeSet>

  <changeSet id="KH-26" author="Willyan Tomaz">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="USUARIO"/>
        <tableExists tableName="IMAGEM"/>
        <not>
          <foreignKeyConstraintExists foreignKeyName="fk_usuario_imagem"/>
        </not>
      </and>
    </preConditions>
    <addForeignKeyConstraint
      baseTableName="USUARIO"
      baseColumnNames="id_imagem_perfil"
      constraintName="fk_usuario_imagem"
      referencedTableName="IMAGEM"
      referencedColumnNames="id"
      onDelete="SET NULL"/>
    <createIndex tableName="USUARIO" indexName="idx_usuario_id_imagem_perfil">
      <column name="id_imagem_perfil"/>
    </createIndex>
  </changeSet>

</databaseChangeLog>
