<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="KH-3" author="Gabriel Marassi">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="USUARIO_TAGS"/>
      </not>
      <tableExists tableName="USUARIO"/>
      <tableExists tableName="TAGS"/>
    </preConditions>
    <createTable tableName="USUARIO_TAGS">
      <column name="usuario_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tag_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey
      tableName="USUARIO_TAGS"
      columnNames="usuario_id, tag_id"
      constraintName="pk_usuario_tags"/>

    <addForeignKeyConstraint
      baseTableName="USUARIO_TAGS"
      baseColumnNames="usuario_id"
      constraintName="fk_usuario_tags_usuario"
      referencedTableName="USUARIO"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <addForeignKeyConstraint
      baseTableName="USUARIO_TAGS"
      baseColumnNames="tag_id"
      constraintName="fk_usuario_tags_tags"
      referencedTableName="TAGS"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <comment>Criação da tabela de relacionamento USUARIO_TAGS</comment>
  </changeSet>

  <changeSet id="KH-20" author="Gabriel Marassi">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="POST_TAGS"/>
      </not>
      <tableExists tableName="POST"/>
      <tableExists tableName="TAGS"/>
    </preConditions>
    <createTable tableName="POST_TAGS">
      <column name="post_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tag_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addPrimaryKey
      tableName="POST_TAGS"
      columnNames="post_id, tag_id"
      constraintName="pk_post_tags"/>

    <addForeignKeyConstraint
      baseTableName="POST_TAGS"
      baseColumnNames="post_id"
      constraintName="fk_post_tags_post"
      referencedTableName="POST"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <addForeignKeyConstraint
      baseTableName="POST_TAGS"
      baseColumnNames="tag_id"
      constraintName="fk_post_tags_tags"
      referencedTableName="TAGS"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <comment>Criação da tabela de relacionamento POST_TAGS</comment>
  </changeSet>

  <changeSet id="KH-25" author="Willyan Tomaz">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="IMAGEM"/>
      </not>
    </preConditions>
    <createTable tableName="IMAGEM">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="nome" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="url" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="id_imagem" type="VARCHAR(255)"/>
      <column name="path" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <comment>Criação da tabela IMAGEM</comment>
  </changeSet>

  <changeSet id="KH-26" author="Willyan Tomaz">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="USUARIO"/>
        <tableExists tableName="IMAGEM"/>
        <not>
          <foreignKeyConstraintExists foreignKeyName="fk_usuario_imagem"/>
        </not>
      </and>
    </preConditions>
    <addForeignKeyConstraint
      baseTableName="USUARIO"
      baseColumnNames="id_imagem_perfil"
      constraintName="fk_usuario_imagem"
      referencedTableName="IMAGEM"
      referencedColumnNames="id"
      onDelete="SET NULL"/>
    <createIndex tableName="USUARIO" indexName="idx_usuario_id_imagem_perfil">
      <column name="id_imagem_perfil"/>
    </createIndex>
  </changeSet>

  <changeSet id="KH-36" author="Willyan Tomaz">
    <createTable tableName="inscricao">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_inscricao"/>
      </column>

      <column name="id_usuario" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="id_workshop" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="status" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>

      <column name="data_inscricao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="inscricao"
      baseColumnNames="id_usuario"
      referencedTableName="usuario"
      referencedColumnNames="id"
      constraintName="fk_inscricao_usuario"/>

    <addForeignKeyConstraint
      baseTableName="inscricao"
      baseColumnNames="id_workshop"
      referencedTableName="workshop"
      referencedColumnNames="id"
      constraintName="fk_inscricao_workshop"/>

    <addUniqueConstraint
      tableName="inscricao"
      columnNames="id_usuario, id_workshop"
      constraintName="uk_usuario_workshop_inscricao"/>

    <rollback>
      <dropTable tableName="inscricao"/>
    </rollback>
  </changeSet>

  <changeSet id="37" author="willyan">
    <addColumn tableName="workshop">
      <column name="custo" type="INT" defaultValueNumeric="0">
              <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>
  
  <changeSet id="KH-30" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="USUARIO"/>
        <not>
          <columnExists tableName="USUARIO" columnName="qntd_token"/>
        </not>
        <not>
          <columnExists tableName="USUARIO" columnName="qntd_xp"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="USUARIO">
      <column name="qntd_token" type="INTEGER" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="qntd_xp" type="INTEGER" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <createIndex tableName="USUARIO" indexName="idx_usuario_qntd_token">
      <column name="qntd_token"/>
    </createIndex>

    <createIndex tableName="USUARIO" indexName="idx_usuario_qntd_xp">
      <column name="qntd_xp"/>
    </createIndex>

    <rollback>
      <dropIndex tableName="USUARIO" indexName="idx_usuario_qntd_token"/>
      <dropIndex tableName="USUARIO" indexName="idx_usuario_qntd_xp"/>
      <dropColumn tableName="USUARIO" columnName="qntd_token"/>
      <dropColumn tableName="USUARIO" columnName="qntd_xp"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-31" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="USUARIO"/>
        <columnExists tableName="USUARIO" columnName="sobrenome"/>
        <not>
          <columnExists tableName="USUARIO" columnName="biografia"/>
        </not>
      </and>
    </preConditions>

    <renameColumn
      tableName="USUARIO"
      oldColumnName="sobrenome"
      newColumnName="biografia"
      columnDataType="VARCHAR(500)"/>

    <rollback>
      <renameColumn
        tableName="USUARIO"
        oldColumnName="biografia"
        newColumnName="sobrenome"
        columnDataType="VARCHAR(500)"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-32" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="COMENTARIO"/>
        <not>
          <columnExists tableName="COMENTARIO" columnName="resposta_destaque"/>
        </not>
      </and>
    </preConditions>
    <addColumn tableName="COMENTARIO">
      <column name="resposta_destaque" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="KH-34" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="COMENTARIO"/>
        <not>
          <columnExists tableName="COMENTARIO" columnName="maior_qntd_voto"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="COMENTARIO">
      <column name="maior_qntd_voto" type="INTEGER" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <rollback>
      <dropColumn tableName="COMENTARIO" columnName="maior_qntd_voto"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-35" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="POST"/>
        <not>
          <columnExists tableName="POST" columnName="maior_qntd_voto"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="POST">
      <column name="maior_qntd_voto" type="INTEGER" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <rollback>
      <dropColumn tableName="POST" columnName="maior_qntd_voto"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-38" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="HISTORICO_TRANSACAO"/>
      </not>
    </preConditions>

    <createTable tableName="HISTORICO_TRANSACAO">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="usuario_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="quantidade" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="motivo" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>

      <column name="descricao" type="VARCHAR(500)"/>

      <column name="data_transacao" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet id="KH-39" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="HISTORICO_TRANSACAO"/>
        <tableExists tableName="USUARIO"/>
        <not>
          <foreignKeyConstraintExists foreignKeyName="fk_historico_transacao_usuario"/>
        </not>
      </and>
    </preConditions>

    <addForeignKeyConstraint
      baseTableName="HISTORICO_TRANSACAO"
      baseColumnNames="usuario_id"
      constraintName="fk_historico_transacao_usuario"
      referencedTableName="USUARIO"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
  </changeSet>

  <changeSet id="KH-40" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="HISTORICO_TRANSACAO"/>
    </preConditions>

    <createIndex tableName="HISTORICO_TRANSACAO" indexName="idx_historico_usuario_id">
      <column name="usuario_id"/>
    </createIndex>

    <createIndex tableName="HISTORICO_TRANSACAO" indexName="idx_historico_data_transacao">
      <column name="data_transacao"/>
    </createIndex>

    <createIndex tableName="HISTORICO_TRANSACAO" indexName="idx_historico_motivo">
      <column name="motivo"/>
    </createIndex>

    <createIndex tableName="HISTORICO_TRANSACAO" indexName="idx_historico_usuario_data">
      <column name="usuario_id"/>
      <column name="data_transacao"/>
    </createIndex>
  </changeSet>

  <changeSet id="KH-41" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="USUARIO"/>
        <not>
          <columnExists tableName="USUARIO" columnName="nivel"/>
        </not>
      </and>
    </preConditions>

    <addColumn tableName="USUARIO">
      <column name="nivel" type="INTEGER" defaultValueNumeric="1">
        <constraints nullable="false"/>
      </column>
    </addColumn>

    <rollback>
      <dropColumn tableName="USUARIO" columnName="nivel"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-29" author="Willyan Tomaz">
    <preConditions onFail="MARK_RAN">
      <and>
        <tableExists tableName="POST"/>
        <tableExists tableName="IMAGEM"/>
        <not>
          <tableExists tableName="IMAGEM_POST"/>
        </not>
      </and>
    </preConditions>

    <createTable tableName="IMAGEM_POST">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_imagem_post"/>
      </column>

      <column name="post_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="imagem_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="ordem_imagem" type="INT">
        <constraints nullable="false"/>
      </column>
    </createTable>

    <addForeignKeyConstraint
      baseTableName="IMAGEM_POST"
      baseColumnNames="post_id"
      constraintName="fk_imagem_post_post"
      referencedTableName="POST"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <addForeignKeyConstraint
      baseTableName="IMAGEM_POST"
      baseColumnNames="imagem_id"
      constraintName="fk_imagem_post_imagem"
      referencedTableName="IMAGEM"
      referencedColumnNames="id"
      onDelete="CASCADE"/>

    <createIndex tableName="IMAGEM_POST" indexName="idx_imagem_post_post">
      <column name="post_id"/>
    </createIndex>

    <createIndex tableName="IMAGEM_POST" indexName="idx_imagem_post_ordem">
      <column name="ordem_imagem"/>
    </createIndex>
  </changeSet>

  <changeSet id="KH-33" author="Willyan Tomaz">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="descricao_workshop"/>
    </preConditions>

    <addColumn tableName="descricao_workshop">
      <column name="id_imagem_workshop" type="BIGINT"/>
    </addColumn>

    <addForeignKeyConstraint
      baseTableName="descricao_workshop"
      baseColumnNames="id_imagem_workshop"
      referencedTableName="imagem"
      referencedColumnNames="id"
      constraintName="fk_descricao_workshop_imagem"/>

    <rollback>
      <dropForeignKeyConstraint
        baseTableName="descricao_workshop"
        constraintName="fk_descricao_workshop_imagem"/>

      <dropColumn tableName="descricao_workshop" columnName="id_imagem_workshop"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-43" author="Willyan Tomaz">
    <preConditions onFail="MARK_RAN">
      <columnExists tableName="IMAGEM" columnName="id_imagem"/>
    </preConditions>
    <renameColumn tableName="IMAGEM" oldColumnName="id_imagem" newColumnName="id_imagem_supabase" columnDataType="VARCHAR(255)"/>
    <addColumn tableName="IMAGEM">
      <column name="type" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>


</databaseChangeLog>
