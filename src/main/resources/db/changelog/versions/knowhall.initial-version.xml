    </rollback>
  </changeSet>

  <changeSet id="KH-24" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <tableExists tableName="descricao_workshop"/>
      <tableExists tableName="workshop"/>
      <not>
