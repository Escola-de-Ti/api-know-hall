        <indexExists tableName="USUARIO_CONQUISTA" indexName="idx_usuario_conquista_conquista"/>
      </not>
    </preConditions>
    <createIndex tableName="USUARIO_CONQUISTA" indexName="idx_usuario_conquista_conquista">
      <column name="conquista_id"/>
    </createIndex>
