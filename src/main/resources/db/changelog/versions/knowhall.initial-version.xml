    <preConditions onFail="MARK_RAN">
      <not>
        <foreignKeyConstraintExists foreignKeyName="fk_usuario_conquista_usuario"/>
      </not>
    </preConditions>
    <addForeignKeyConstraint
      baseTableName="USUARIO_CONQUISTA"
      baseColumnNames="usuario_id"
      constraintName="fk_usuario_conquista_usuario"
      referencedTableName="USUARIO"
