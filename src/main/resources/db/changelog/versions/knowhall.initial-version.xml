    <rollback>
      <dropIndex tableName="USUARIO_CONQUISTA" indexName="idx_usuario_conquista_conquista"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-18" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
