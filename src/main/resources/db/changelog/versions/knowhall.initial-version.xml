  </changeSet>

  <changeSet id="KH-13" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <not>
        <indexExists tableName="CONQUISTA" indexName="idx_conquista_tipo"/>
      </not>
    </preConditions>
    <createIndex tableName="CONQUISTA" indexName="idx_conquista_tipo">
      <column name="tipo_conquista"/>
    </createIndex>
    <comment>Criar índice para buscar conquistas por tipo</comment>
    <rollback>
      <dropIndex tableName="CONQUISTA" indexName="idx_conquista_tipo"/>
    </rollback>
  </changeSet>

