<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xmlns:pro="http://www.liquibase.org/xml/ns/pro"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
    http://www.liquibase.org/xml/ns/dbchangelog-ext
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
    http://www.liquibase.org/xml/ns/pro
    http://www.liquibase.org/xml/ns/pro/liquibase-pro-latest.xsd">


  <changeSet id="KH-1" author="WILLYAN TOMAZ">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="USUARIO"/>
      </not>
    </preConditions>
    <createTable tableName="USUARIO">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="email" type="VARCHAR(255)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="cpf" type="VARCHAR(11)">
        <constraints nullable="false" unique="true"/>
      </column>
      <column name="telefone" type="VARCHAR(20)"/>
      <column name="telefone2" type="VARCHAR(20)"/>
      <column name="nome" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="sobrenome" type="VARCHAR(255)"/>
      <column name="senha_hash" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="id_imagem_perfil" type="INTEGER"/>
      <column name="status_usuario" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
      <column name="tipo_usuario" type="VARCHAR(50)">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <comment>Criação da tabela USUARIO</comment>
  </changeSet>

  <changeSet id="KH-2" author="Gabriel Marassi">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="TAGS"/>
      </not>
    </preConditions>
    <createTable tableName="TAGS">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="name" type="VARCHAR(255)"/>
    </createTable>
    <comment>Criação da tabela TAGS</comment>
  </changeSet>

  <changeSet id="KH-4" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="CONQUISTA"/>
      </not>
    </preConditions>
    <createTable tableName="CONQUISTA">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="tipo_conquista" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
      <column name="campo_validacao" type="VARCHAR(100)">
        <constraints nullable="false"/>
      </column>
      <column name="nome" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="descricao" type="TEXT">
        <constraints nullable="true"/>
      </column>
      <column name="icone_url" type="VARCHAR(500)">
        <constraints nullable="true"/>
      </column>
    </createTable>
    <comment>Criação da tabela CONQUISTA</comment>
    <rollback>
      <dropTable tableName="CONQUISTA"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-5" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="CONQUISTA_TIER"/>
      </not>
    </preConditions>
    <createTable tableName="CONQUISTA_TIER">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="conquista_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="tier" type="VARCHAR(20)">
        <constraints nullable="false"/>
      </column>
      <column name="quantidade_necessaria" type="INT">
        <constraints nullable="false"/>
      </column>
      <column name="descricao_tier" type="VARCHAR(500)">
        <constraints nullable="true"/>
      </column>
    </createTable>
    <comment>Criação da tabela CONQUISTA_TIER</comment>
    <rollback>
      <dropTable tableName="CONQUISTA_TIER"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-6" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <not>
        <foreignKeyConstraintExists foreignKeyName="fk_conquista_tier_conquista"/>
      </not>
    </preConditions>
    <addForeignKeyConstraint
      baseTableName="CONQUISTA_TIER"
      baseColumnNames="conquista_id"
      constraintName="fk_conquista_tier_conquista"
      referencedTableName="CONQUISTA"
      referencedColumnNames="id"
      onDelete="CASCADE"/>
    <comment>Adicionar FK entre CONQUISTA_TIER e CONQUISTA</comment>
    <rollback>
      <dropForeignKeyConstraint
        baseTableName="CONQUISTA_TIER"
        constraintName="fk_conquista_tier_conquista"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-7" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <not>
        <uniqueConstraintExists tableName="CONQUISTA_TIER" constraintName="uk_conquista_tier"/>
      </not>
    </preConditions>
    <addUniqueConstraint
      tableName="CONQUISTA_TIER"
      columnNames="conquista_id, tier"
      constraintName="uk_conquista_tier"/>
    <comment>Adicionar constraint única (conquista_id, tier) em CONQUISTA_TIER</comment>
    <rollback>
      <dropUniqueConstraint
        tableName="CONQUISTA_TIER"
        constraintName="uk_conquista_tier"/>
    </rollback>
  </changeSet>

  <changeSet id="KH-8" author="GABRIEL MARASSI">
    <preConditions onFail="MARK_RAN">
      <not>
        <tableExists tableName="USUARIO_CONQUISTA"/>
      </not>
    </preConditions>
    <createTable tableName="USUARIO_CONQUISTA">
      <column name="id" type="BIGSERIAL">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="usuario_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="conquista_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="conquista_tier_id" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="data_obtencao" type="TIMESTAMP">
        <constraints nullable="false"/>
      </column>
      <column name="progresso_atual" type="INT">
        <constraints nullable="true"/>
      </column>
    </createTable>
    <comment>Criação da tabela USUARIO_CONQUISTA</comment>
    <rollback>
      <dropTable tableName="USUARIO_CONQUISTA"/>
    </rollback>
  </changeSet>

